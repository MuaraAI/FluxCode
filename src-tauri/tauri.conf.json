{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxCode",
  "version": "0.5.1-dev.2026-11-07-1500",
  "identifier": "id.mykine.fluxcode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "shortDescription": "Lightweight code editor for Python and Web",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 MuaraAI. All rights reserved.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1",
          "libssl3 | libssl1.1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
