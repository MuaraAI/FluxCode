# Maintainer: MuaraAI <team@muaraai.com>
pkgname=fluxcode-bin
pkgver=0.4.2
pkgrel=1
pkgdesc="Lightweight code editor for Python and Web built with Tauri and CodeMirror 6"
arch=('x86_64' 'aarch64')
url="https://github.com/MuaraAI/FluxCode"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'openssl')
provides=('fluxcode')
conflicts=('fluxcode')
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::https://github.com/MuaraAI/FluxCode/releases/download/v${pkgver}/fluxcode_${pkgver}_amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::https://github.com/MuaraAI/FluxCode/releases/download/v${pkgver}/fluxcode_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
    chmod 755 "${pkgdir}/usr/bin/fluxcode"
    install -Dm644 "${startdir:-.}/fluxcode.desktop" "${pkgdir}/usr/share/applications/fluxcode.desktop" 2>/dev/null || true
    install -Dm644 "${startdir:-.}/../../LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}
